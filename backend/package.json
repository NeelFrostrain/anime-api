{
  "name": "anime-api-worker",
  "version": "2.0.0",
  "description": "Kuromi Anime API - Cloudflare Worker with D1 Database & Workers KV",
  "main": "cf_worker/index.ts",
  "type": "module",
  "scripts": {
    "dev": "python api.py",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute anime-d1 --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute anime-d1 --remote --file=./schema.sql",
    "types": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241011.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.80.5"
  }
}
